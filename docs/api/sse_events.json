{
  "schema_version": "2.0",
  "description": "Versioned catalogue of the server-sent events a chat turn emits on POST /api/chat_stream and GET /api/chat/resume/{session_id}. Every JSON frame carries the envelope fields; `delta` frames carry no `type`. The literal frame `data: [DONE]` ends the stream. `stability: core` events are typed by sdk/ts and covered by tests/test_sse_catalog.py; `extended` events are passed through by the SDK as UnknownEvent and may change between minor versions.",
  "framing": {
    "line": "data: <json>\\n\\n",
    "named_events": ["web_sources", "context_receipts", "git_policy", "error"],
    "terminator": "[DONE]",
    "heartbeat_seconds": 10
  },
  "envelope": {
    "sequence": "int, 1-based, stable across compaction; pass the last seen value as ?cursor= to resume",
    "trace_id": "string, equals the run id",
    "step_id": "string, <run_id>:<round>",
    "stream_id": "string, equals the run id",
    "schema_version": "string, \"2.0\""
  },
  "headers": {
    "X-Odysseus-Run-Id": "response header on chat_stream/resume; request header on stop (fencing token)",
    "X-Faustus-Api-Version": "server API version on every /api/* response",
    "X-Faustus-Client-Version": "optional request header; 426 when below the server floor",
    "X-Faustus-Idempotent-Replay": "\"1\" when a repeated client_message_id re-attached to the existing run"
  },
  "events": [
    {"type": null, "name": "delta", "stability": "core", "fields": {"delta": "string", "thinking": "bool?"}, "note": "text tokens; `thinking` marks reasoning text"},
    {"type": "tool_start", "stability": "core", "fields": {"tool": "string", "command": "string?", "full_command": "string?", "round": "int?"}},
    {"type": "tool_progress", "stability": "core", "fields": {"tool": "string?", "message": "string?", "event": "string?", "subagent": "object?"}},
    {"type": "tool_output", "stability": "core", "fields": {"tool": "string", "command": "string?", "output": "string?", "exit_code": "int?", "diff": "string?", "doc_id": "string?", "screenshot": "string?", "argument_errors": "array?", "repairs": "array?", "evidence_refs": "array?", "execution_target": "object?", "call_id": "string?"}},
    {"type": "tool_effect", "stability": "core", "fields": {"call_id": "string", "tool": "string", "effect_class": "string", "state": "pending|confirmed|failed", "idempotency_key": "string"}},
    {"type": "agent_step", "stability": "core", "fields": {"round": "int"}},
    {"type": "ask_user", "stability": "core", "fields": {"data": {"question": "string", "options": "[{id,label,description?}]", "multi": "bool?", "kind": "question|tool_approval", "approval_id": "string?", "question_id": "string?", "revision": "int?", "allow_free_text": "bool?"}}, "note": "answered by the next POST /api/chat_stream: question_id+option_ids/message+revision, or tool_approval_id+tool_approval_decision (approve|approve_task|deny)"},
    {"type": "ask_user_resolved", "stability": "core", "fields": {}},
    {"type": "tool_approval_resolved", "stability": "core", "fields": {}},
    {"type": "run_activity", "stability": "core", "fields": {"data": {"phase": "string", "phase_since": "number?", "tool": "string?", "detail": "string?", "model_state": "string?", "round": "int?"}, "heartbeat": "int?"}, "note": "also the heartbeat: synthesized after 10 s of silence"},
    {"type": "metrics", "stability": "core", "fields": {"data": "object"}},
    {"type": "chat_terminal", "stability": "core", "fields": {"data": "object"}, "note": "clean end of a chat turn"},
    {"type": "agent_terminal", "stability": "core", "fields": {"data": {"failure": "{message, error_class}?"}}, "note": "end of an agent turn, failed when `failure` is present"},
    {"type": "error", "stability": "core", "fields": {"text": "string?", "error": "string?", "message": "string?", "detail": "string?", "error_class": "string?"}},
    {"type": "message_saved", "stability": "core", "fields": {"id": "string"}},
    {"type": "uncertain", "stability": "core", "fields": {"status": "string", "detail": "string?"}, "note": "idempotent replay could not find the run but its outbox row is still accepted/running"},
    {"type": "capabilities_changed", "stability": "core", "fields": {"data": {"from_model": "string", "to_model": "string", "lost": "array"}}},
    {"type": "plan_update", "stability": "core", "fields": {"data": {"plan": "any", "steps": "array", "revision": "int", "warnings": "array"}}},
    {"type": "progress_update", "stability": "core", "fields": {"todos": "[{content,status,priority,verified}]"}},
    {"type": "harness_summary", "stability": "core", "fields": {"data": "object"}},
    {"type": "context_ledger", "stability": "core", "fields": {"data": "object"}},
    {"type": "web_sources", "stability": "core", "fields": {"data": "[{title,url}]"}},
    {"type": "context_receipts", "stability": "core", "fields": {"data": "[{source,kind,ref,why}]"}},
    {"type": "git_policy", "stability": "core", "fields": {"action": "branch|commit|push", "ok": "bool", "branch": "string?", "sha": "string?", "detail": "string?"}},
    {"type": "strategy", "stability": "core", "fields": {"data": "object"}},
    {"type": "fallback", "stability": "core", "fields": {"answered_by": "string?", "selected_model": "string?"}},
    {"type": "queue_status", "stability": "extended", "fields": {}},
    {"type": "paused", "stability": "extended", "fields": {}},
    {"type": "steer", "stability": "extended", "fields": {}},
    {"type": "compacted", "stability": "extended", "fields": {}},
    {"type": "context_trimmed", "stability": "extended", "fields": {}},
    {"type": "memories_used", "stability": "extended", "fields": {}},
    {"type": "rag_sources", "stability": "extended", "fields": {}},
    {"type": "research_sources", "stability": "extended", "fields": {}},
    {"type": "research_progress", "stability": "extended", "fields": {}},
    {"type": "research_findings", "stability": "extended", "fields": {}},
    {"type": "research_done", "stability": "extended", "fields": {}},
    {"type": "vram_admission", "stability": "extended", "fields": {}},
    {"type": "generated_image", "stability": "extended", "fields": {}},
    {"type": "harness_check", "stability": "extended", "fields": {}},
    {"type": "browser_view", "stability": "extended", "fields": {}},
    {"type": "doc_stream_open", "stability": "extended", "fields": {}},
    {"type": "doc_stream_delta", "stability": "extended", "fields": {}},
    {"type": "doc_update", "stability": "extended", "fields": {}},
    {"type": "doc_suggestions", "stability": "extended", "fields": {}}
  ]
}
