{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:faustus:creator-plan:reference:handoff:1",
  "title": "REFERENCE ONLY — handoff",
  "description": "Contrato de diseño ilustrativo. No es una API existente ni prueba de validación de seguridad del runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "example_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "goal_id": {
      "type": "string",
      "minLength": 1
    },
    "goal_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "source_turn_id": {
      "type": "string",
      "minLength": 1
    },
    "source_event_sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "document_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "document_id": {
            "type": "string",
            "pattern": "^doc_[A-Za-z0-9_-]+$"
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "document_id",
          "revision"
        ]
      },
      "minItems": 0
    },
    "completed_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "pending_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "uncertain_effects": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "submit_unknown",
              "unknown"
            ]
          },
          "next_action": {
            "const": "reconcile_before_retry"
          }
        },
        "required": [
          "run_id",
          "status",
          "next_action"
        ]
      },
      "minItems": 0
    },
    "permission_transfer": {
      "const": "none"
    },
    "requires_revalidation": {
      "type": "array",
      "items": {
        "enum": [
          "owner_scope",
          "document_revisions",
          "capabilities",
          "budget",
          "consent"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "publication_state": {
      "enum": [
        "prepared",
        "published"
      ]
    }
  },
  "required": [
    "schema_version",
    "example_only",
    "id",
    "goal_id",
    "goal_revision",
    "project_id",
    "source_turn_id",
    "source_event_sequence",
    "summary",
    "document_refs",
    "completed_criteria",
    "pending_criteria",
    "uncertain_effects",
    "permission_transfer",
    "requires_revalidation",
    "publication_state"
  ]
}