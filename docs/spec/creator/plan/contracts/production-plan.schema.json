{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:faustus:creator-plan:reference:production-plan:1",
  "title": "REFERENCE ONLY — production-plan",
  "description": "Contrato de diseño ilustrativo. No es una API existente ni prueba de validación de seguridad del runtime.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "example_only": {
      "type": "boolean"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^prj_[A-Za-z0-9_-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^doc_[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "document_id",
        "revision"
      ]
    },
    "available_assets": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^occ_[A-Za-z0-9_-]+$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "operation": {
            "type": "string",
            "minLength": 1
          },
          "adapter_id": {
            "type": "string",
            "minLength": 1
          },
          "input_assets": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^occ_[A-Za-z0-9_-]+$"
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "input_documents": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "document_id": {
                  "type": "string",
                  "pattern": "^doc_[A-Za-z0-9_-]+$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "document_id",
                "revision"
              ]
            },
            "minItems": 0
          },
          "parameters": {
            "type": "object"
          },
          "external_effect": {
            "type": "boolean"
          },
          "retry_policy": {
            "enum": [
              "before_effect_only",
              "idempotent_with_receipt",
              "manual_reconcile"
            ]
          }
        },
        "required": [
          "id",
          "depends_on",
          "operation",
          "adapter_id",
          "input_assets",
          "input_documents",
          "parameters",
          "external_effect",
          "retry_policy"
        ]
      },
      "minItems": 1
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "artifact_decodes",
              "duration_matches",
              "schema_valid",
              "human_editorial_acceptance"
            ]
          },
          "target_node": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "needs_review"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "kind",
          "target_node",
          "state",
          "evidence_refs"
        ]
      },
      "minItems": 1
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "currency": {
          "enum": [
            "EUR",
            "USD"
          ]
        },
        "max_external_amount": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]{2}$"
        },
        "max_model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "max_attempts_per_node": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "currency",
        "max_external_amount",
        "max_model_calls",
        "max_attempts_per_node"
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {
          "enum": [
            "required",
            "approved",
            "revoked",
            "expired"
          ]
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "state",
        "plan_digest"
      ]
    },
    "execution_requested": {
      "type": "boolean"
    }
  },
  "required": [
    "schema_version",
    "example_only",
    "id",
    "project_id",
    "revision",
    "brief",
    "available_assets",
    "nodes",
    "criteria",
    "budget",
    "approval",
    "execution_requested"
  ]
}