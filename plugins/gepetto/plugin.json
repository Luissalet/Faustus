{
  "schema": 1,
  "id": "gepetto",
  "name": "Gepetto's Hoard",
  "purpose": "Drive Gepetto's Hoard's 3D projects, analysis and jobs through its REST API.",
  "capabilities": [
    "projects",
    "analysis",
    "jobs"
  ],
  "placeholders": [
    "GEPETTO_DIR",
    "APP_URL"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:8767",
    "DATA_DIR": "{GEPETTO_DIR}/data"
  },
  "app": {
    "url_default": "http://127.0.0.1:8767",
    "ui_url": "{APP_URL}",
    "health": {
      "path": "/api/health",
      "expect": {
        "application": "sculptors-hoard"
      }
    },
    "identify": {
      "application": [
        "sculptors-hoard"
      ],
      "title": [
        "gepetto's hoard",
        "sculptor's hoard"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{FAUSTUS_PYTHON}",
      "argv": [
        "start.py"
      ],
      "cwd": "{GEPETTO_DIR}",
      "readiness": {
        "url": "{APP_URL}/api/health",
        "timeout_s": 40
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{FAUSTUS_PYTHON}",
    "args": [
      "{FAUSTUS_DIR}/bridges/rest_mcp/server.py"
    ],
    "env": {
      "REST_BASE_URL": "{APP_URL}",
      "REST_OPENAPI_URL": "{APP_URL}/openapi.json",
      "REST_MANIFEST": "{FAUSTUS_DIR}/bridges/rest_mcp/manifests/gepetto.json",
      "REST_NAME": "Gepetto's Hoard"
    },
    "optional_env": []
  },
  "x-family": {
    "agent_contract": false,
    "stack": "python",
    "note": "REST API (OpenAPI) only, reached from Faustus through its generic REST bridge; no /api/agent/call, no token, no events. start.py picks the venv when present."
  }
}
