{
  "schema": 1,
  "id": "echo",
  "name": "Echo's Hoard",
  "purpose": "Everything the user copies, kept on their own PC, searchable, with frequent copies pinned; the assistant can search the clipboard history and set the clipboard.",
  "capabilities": ["clipboard-history", "search", "pin", "sensitive-detection", "images"],
  "placeholders": ["ECHO_DIR", "APP_URL", "TOKEN_FILE", "PYTHON"],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5188",
    "TOKEN_FILE": "{ECHO_DIR}/data/mcp-token",
    "PYTHON": "{ECHO_DIR}/venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "http://127.0.0.1:5188",
    "ui_url": "{APP_URL}",
    "health": { "path": "/api/health", "expect": { "service": "echo-hoard" } },
    "identify": { "service": ["echo-hoard"], "title": ["echo's hoard", "portapapeles"] },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": ["-m", "echo"],
      "cwd": "{ECHO_DIR}",
      "readiness": { "url": "{APP_URL}/api/health", "timeout_s": 20 }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": ["{ECHO_DIR}/mcp_server.py"],
    "env": { "ECHO_URL": "{APP_URL}", "ECHO_TOKEN_FILE": "{TOKEN_FILE}" },
    "optional_env": []
  },
  "notes": "Keep the app running (python -m echo) while the assistant uses it: the MCP bridge proxies every call to the local server and never opens the database. Sensitive clips (passwords, tokens, cards, IBANs) are never sent to the assistant."
}
