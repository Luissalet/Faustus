{
  "schema": 1,
  "id": "hypatia",
  "name": "Hypatia's Hoard",
  "purpose": "The user's own flashcards with spaced repetition (SM-2): the assistant fills cards from what the user reads and can quiz them in chat; the app is the scheduler and the review UI.",
  "capabilities": ["flashcards", "spaced-repetition", "decks", "review-queue", "quiz", "search", "stats", "import-export"],
  "placeholders": ["HYPATIA_DIR", "APP_URL", "TOKEN_FILE", "PYTHON"],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5187",
    "TOKEN_FILE": "{HYPATIA_DIR}/data/mcp-token",
    "PYTHON": "{HYPATIA_DIR}/venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "http://127.0.0.1:5187",
    "ui_url": "{APP_URL}",
    "health": { "path": "/api/health", "expect": { "service": "hypatia-hoard" } },
    "identify": { "service": ["hypatia-hoard"], "title": ["hypatia's hoard", "tarjetas"] },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": ["-m", "hypatia"],
      "cwd": "{HYPATIA_DIR}",
      "readiness": { "url": "{APP_URL}/api/health", "timeout_s": 20 }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": ["{HYPATIA_DIR}/mcp_server.py"],
    "env": { "HYPATIA_URL": "{APP_URL}", "HYPATIA_TOKEN_FILE": "{TOKEN_FILE}" },
    "optional_env": []
  },
  "notes": "Keep the app running (python -m hypatia) while the assistant uses it: the MCP bridge proxies every call to the local server and never opens the database."
}
