{
  "schema": 1,
  "id": "dorian",
  "name": "Dorian's Hoard",
  "purpose": "Manage local credentials and sessions through Dorian's Hoard's own MCP server.",
  "capabilities": [
    "credentials",
    "sessions"
  ],
  "placeholders": [
    "DORIAN_DIR",
    "APP_URL",
    "CREDENTIAL_FILE"
  ],
  "defaults": {
    "APP_URL": "http://127.0.0.1:8741",
    "CREDENTIAL_FILE": "{DORIAN_DIR}/data/agent-clients/faustus.json",
    "DATA_DIR": "{DORIAN_DIR}/data"
  },
  "app": {
    "url_default": "http://127.0.0.1:8741",
    "ui_url": "{APP_URL}",
    "health": {
      "path": "/api/session",
      "expect": {
        "mode": "local"
      }
    },
    "identify": {
      "mode": [
        "local"
      ],
      "title": [
        "dorian's hoard",
        "dorians hoard",
        "selfhoard"
      ]
    },
    "launch_hint": {
      "kind": "process",
      "executable": "{DORIAN_DIR}/.venv/Scripts/python.exe",
      "argv": [
        "-m",
        "selfhoard"
      ],
      "cwd": "{DORIAN_DIR}",
      "readiness": {
        "url": "{APP_URL}/api/session",
        "timeout_s": 20
      }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{DORIAN_DIR}/.venv/Scripts/python.exe",
    "args": [
      "{DORIAN_DIR}/selfhoard/mcp_server.py",
      "--credential-file",
      "{CREDENTIAL_FILE}"
    ],
    "env": {},
    "optional_env": []
  },
  "x-family": {
    "agent_contract": false,
    "stack": "python",
    "note": "Its MCP server authenticates with per-client credential files, not a bearer token, so the hub proxy does not call it; the hub lists, starts and backs it up (data/ holds the credential store: keep backups local)."
  },
  "notes": "Knowledge about the user rather than tools over a domain: this is the plugin that widens what Faustus knows about who it works for."
}
