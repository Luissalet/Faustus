{
  "schema": 1,
  "id": "nightingale",
  "name": "Nightingale's Hoard",
  "purpose": "The user's own data workbench: ingest files/folders/URLs into a local DuckDB workbench, clean data with versioned steps (undo/redo, lineage, replay), run quality rules, build charts and dashboards, and train quick models — every operation recorded and explained.",
  "capabilities": ["ingest", "transform", "quality-rules", "charts", "dashboards", "models", "forecasting", "sql-query", "analysis-log", "ask-your-data"],
  "placeholders": ["NIGHTINGALE_DIR", "APP_URL", "TOKEN_FILE", "PYTHON"],
  "defaults": {
    "APP_URL": "http://127.0.0.1:5189",
    "TOKEN_FILE": "{NIGHTINGALE_DIR}/data/mcp-token",
    "PYTHON": "{NIGHTINGALE_DIR}/venv/Scripts/python.exe"
  },
  "app": {
    "url_default": "http://127.0.0.1:5189",
    "ui_url": "{APP_URL}",
    "health": { "path": "/api/health", "expect": { "service": "nightingale-hoard" } },
    "identify": { "service": ["nightingale-hoard"], "title": ["nightingale's hoard", "data workbench"] },
    "launch_hint": {
      "kind": "process",
      "executable": "{PYTHON}",
      "argv": ["-m", "nightingale"],
      "cwd": "{NIGHTINGALE_DIR}",
      "readiness": { "url": "{APP_URL}/api/health", "timeout_s": 20 }
    }
  },
  "mcp": {
    "transport": "stdio",
    "command": "{PYTHON}",
    "args": ["{NIGHTINGALE_DIR}/mcp_server.py"],
    "env": { "NIGHTINGALE_URL": "{APP_URL}", "NIGHTINGALE_TOKEN_FILE": "{TOKEN_FILE}" },
    "optional_env": []
  },
  "notes": "Keep the app running (python -m nightingale) while the assistant uses it: the MCP bridge proxies every call to the local server and never opens the database directly."
}
