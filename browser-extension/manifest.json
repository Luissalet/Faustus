{
  "manifest_version": 3,
  "name": "Faustus Browser Session",
  "description": "Connect Faustus to explicitly selected tabs in this browser session.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["debugger", "tabs", "alarms"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "Faustus Browser: disconnected. Click to reconnect."},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:7016"}
}
