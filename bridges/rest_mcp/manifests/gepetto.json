{
  "name": "Gepetto's Hoard",
  "instructions": "Fallback tool listing for Gepetto's Hoard when its OpenAPI document (http://127.0.0.1:8767/openapi.json) cannot be fetched. Prefer REST_OPENAPI_URL when the app is reachable — this manifest exists so read and write tools still show up when it is not.",
  "tools": [
    {"name": "get_health", "description": "Health check.", "method": "GET", "path": "/api/health", "params": {}, "readonly": true},
    {"name": "get_models", "description": "List available models.", "method": "GET", "path": "/api/models", "params": {}, "readonly": true},
    {"name": "list_projects", "description": "List projects.", "method": "GET", "path": "/api/projects", "params": {}, "readonly": true},
    {"name": "get_project", "description": "Get one project.", "method": "GET", "path": "/api/projects/{pid}",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."}}, "readonly": true},
    {"name": "get_project_analysis_status", "description": "Analysis status for a project.", "method": "GET",
     "path": "/api/projects/{pid}/analysis-status",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."}}, "readonly": true},
    {"name": "get_job", "description": "Get a job by id.", "method": "GET", "path": "/api/jobs/{jid}",
     "params": {"jid": {"in": "path", "type": "string", "required": true, "description": "Job id."}}, "readonly": true},
    {"name": "get_runtime", "description": "Runtime info.", "method": "GET", "path": "/api/runtime", "params": {}, "readonly": true},
    {"name": "get_batch", "description": "Batch status.", "method": "GET", "path": "/api/batch", "params": {}, "readonly": true},
    {"name": "get_project_history", "description": "History for a project.", "method": "GET",
     "path": "/api/projects/{pid}/history",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."}}, "readonly": true},
    {"name": "create_project", "description": "Create a project.", "method": "POST", "path": "/api/projects",
     "params": {"body": {"in": "body", "type": "object", "required": true, "description": "New project payload."}}, "readonly": false},
    {"name": "analyze_project", "description": "Start analysis for a project.", "method": "POST",
     "path": "/api/projects/{pid}/analyze",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Analysis options."}}, "readonly": false},
    {"name": "apply_project", "description": "Apply changes to a project.", "method": "POST",
     "path": "/api/projects/{pid}/apply",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Apply payload."}}, "readonly": false},
    {"name": "command_project", "description": "Send a command to a project.", "method": "POST",
     "path": "/api/projects/{pid}/command",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."},
                "body": {"in": "body", "type": "object", "required": true, "description": "Command payload."}}, "readonly": false},
    {"name": "save_project", "description": "Save a project.", "method": "POST",
     "path": "/api/projects/{pid}/save",
     "params": {"pid": {"in": "path", "type": "string", "required": true, "description": "Project id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Save options."}}, "readonly": false}
  ]
}
