{
  "name": "Plato's Hoard",
  "instructions": "Tool listing for Plato's Hoard's editor API (/api/v2). POST /api/process takes a multipart image upload and is intentionally not exposed as a tool — there is no file upload over stdio here.",
  "tools": [
    {"name": "list_documents", "description": "List documents.", "method": "GET", "path": "/api/v2/documents", "params": {}, "readonly": true},
    {"name": "get_document", "description": "Get one document.", "method": "GET", "path": "/api/v2/documents/{doc_id}",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."}}, "readonly": true},
    {"name": "create_document", "description": "Create a document.", "method": "POST", "path": "/api/v2/documents",
     "params": {"body": {"in": "body", "type": "object", "required": true, "description": "New document payload."}}, "readonly": false},
    {"name": "document_command", "description": "Send an editor command to a document.", "method": "POST",
     "path": "/api/v2/documents/{doc_id}/commands",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."},
                "body": {"in": "body", "type": "object", "required": true, "description": "Command payload."}}, "readonly": false},
    {"name": "document_fit", "description": "Run fit on a document.", "method": "POST",
     "path": "/api/v2/documents/{doc_id}/fit",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Fit options."}}, "readonly": false},
    {"name": "document_constrain", "description": "Run constrain on a document.", "method": "POST",
     "path": "/api/v2/documents/{doc_id}/constrain",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Constrain options."}}, "readonly": false},
    {"name": "document_preview", "description": "Render a preview of a document.", "method": "POST",
     "path": "/api/v2/documents/{doc_id}/preview",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Preview options."}}, "readonly": false},
    {"name": "document_mesh_rings", "description": "Generate mesh rings for a document.", "method": "POST",
     "path": "/api/v2/documents/{doc_id}/mesh-rings",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Mesh-ring options."}}, "readonly": false},
    {"name": "document_exports", "description": "Export a document.", "method": "POST",
     "path": "/api/v2/documents/{doc_id}/exports",
     "params": {"doc_id": {"in": "path", "type": "string", "required": true, "description": "Document id."},
                "body": {"in": "body", "type": "object", "required": false, "description": "Export options."}}, "readonly": false},
    {"name": "get_job", "description": "Get a job by id.", "method": "GET", "path": "/api/v2/jobs/{job_id}",
     "params": {"job_id": {"in": "path", "type": "string", "required": true, "description": "Job id."}}, "readonly": true},
    {"name": "cancel_job", "description": "Cancel a job.", "method": "POST", "path": "/api/v2/jobs/{job_id}/cancel",
     "params": {"job_id": {"in": "path", "type": "string", "required": true, "description": "Job id."}}, "readonly": false}
  ]
}
