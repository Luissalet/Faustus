# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
!static/js/editor/build/
venv/
.venv/
*.egg

# Environment
.env
.env.bak.*
!.env.example
# Local uv lockfile (optional, per-platform — see "Faster installs with uv" in README)
requirements.lock

# SOPS workflow — encrypted `secrets.env` is intentionally committable,
# but every variant (plaintext, manual decrypt copy, editor backup)
# must stay out of git. Mirrored in .dockerignore so the same artifacts
# also cannot enter image build layers.
secrets.env.*
!secrets.env.example

# Data — all user data stays local
data/
!services/hwfit/data/
!services/hwfit/data/hf_models.json
logs/
*.log
*.db
*.sqlite
*.sqlite3

# Node
node_modules/
services/node_modules/

# Studio build output (rebuilt by scripts/build-studio.js)
static/studio/
services/data/

# IDE / Editor
.aider*
.claude/
.vscode/
.idea/
*.swp
*.swo
*~

# Test capture artifacts (browser session dumps may contain personal content)
.playwright-mcp/
.pytest_cache/
.impeccable/

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.cache
cache/
output.txt.txt

# Media (uploaded/generated)
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.tiff
*.pdf

# …except shipped static assets
!static/icons/*.png
# docs/ is local by default: implementation plans, backlogs, inspiration,
# research reports and UI captures must not enter the repository.
# Keep directories traversable so the explicit file exceptions below work.
/docs/**
!/docs/**/

# Public API contracts and guides linked from the README.
!/docs/api/*.md
!/docs/api/sse_events.json
!/docs/requirements-format.md
!/docs/showcase.md
!/docs/ui/charts.md
!/docs/ui/reply-blocks.md
!/docs/design/durable-change-evidence.md
!/docs/design/state-mirror-recovery.md
!/docs/design/voice-jarvis.md
!/docs/design/diogenes-adaptations.md
!/docs/design/workflow-script-skills.md
!/docs/design/natural-dictation.md
!/docs/design/bounded-workflow-iterations.md
!/docs/evals/typed-decisions.md

# Runtime resources, translation source and executable contract fixtures.
!/docs/recipes/*.json
!/docs/ui/i18n/es.tsv
!/docs/spec/v2/schemas/*.json
!/docs/spec/v2/examples/*.json
!/docs/evals/context_engine_queries.json
!/docs/evals/typed_decision_cases.json
!/docs/spec/paridad/acceptance_cases.json
!/docs/spec/v2/acceptance_scenarios.json
!/docs/HOARDS_INVENTARIO_2026-10-04.json

# Attribution manifest and documents required by existing regression checks.
!/docs/adaptations/provenance.json
!/docs/adaptations/decisions/CMP-01.md
!/docs/adaptations/decisions/CMP-01-layout.md
!/docs/adaptations/decisions/CMP-07.md
!/docs/adaptations/decisions/CMP-11.md
!/docs/adaptations/decisions/CMP-13.md
!/docs/spec/paridad/ESTADO_ACEPTACION.md
!/docs/spec/paridad/SUPERFICIE_PRODUCTO.md
!/docs/spec/v2/QA_ESTADO.md
!/docs/spec/v2/EVAL_ESTADO.md
!/docs/spec/v2/lab/HW-07_spark_pc_egpu.md

# …except shipped website and branding media.
!website/**/*.jpg
!website/**/*.jpeg
!website/**/*.png
!website/**/*.gif
!website/**/*.bmp
!website/**/*.webp
!website/**/*.tiff
!website/**/*.pdf
!assets/branding/**/*.jpg
!assets/branding/**/*.jpeg
!assets/branding/**/*.png
!assets/branding/**/*.gif
!assets/branding/**/*.bmp
!assets/branding/**/*.webp
!assets/branding/**/*.tiff
!assets/branding/**/*.pdf

# ...and the interface screenshots the README embeds. `*.png` above is a
# blanket rule for uploaded and generated media, and a screenshot committed on
# purpose looks exactly like one dropped into a folder by accident - so it has
# to be said here, or the README ships with image links that 404 on GitHub
# while every file sits happily on the machine that wrote it. That is not a
# hypothetical: it happened on 05-09-2026, and tests/test_readme_media_is_
# committed.py exists because of it.
!assets/screens/**/*.png
!assets/screens/**/*.jpg
!assets/screens/**/*.gif
!assets/screens/**/*.webp

# Reports and temp files
reports/
tasks/
scripts/compound/*.json
research_data/
**/search_analytics.json

# Isolated git worktrees (superpowers SDD)
.worktrees/

# Internal dev/review notes — not for public repo
dev-docs/
# Windows-port working docs (local only, not for public repo)
docs/windows-port/

# Local config
compound.config.json
*.error.log
_scratch/
/odysseus/

# Marketplace: ship manifests and the catalogue, recreate source checkouts.
/plugins/*/repository/
/plugins/*/.repository-stage-*/

# Snapshots de data/ (scripts/odysseus-backup y src/backup_service) — pueden ser cientos de MB.
backups/

# sdk/ts (S2): build output and packed tarballs — regenerated by `npm run
# build`/`npm pack`, never committed. node_modules/ and dist/ above already
# match these paths too; listed explicitly since this package's own build
# introduces dist-test/ and *.tgz, which no existing rule covers.
sdk/ts/dist/
sdk/ts/dist-test/
sdk/ts/*.tgz
sdk/ts/node_modules/
