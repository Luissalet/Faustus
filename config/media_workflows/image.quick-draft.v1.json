{
  "id": "image.quick-draft",
  "version": "1.0.0",
  "title": "A fast, small draft for choosing between ideas",
  "engine": "comfyui",
  "description": "512px on Stable Diffusion 1.5 — seconds per image and about 2 GB of VRAM, so it runs on hardware that cannot hold SDXL. This is the recipe for deciding WHAT to make; image.product is the one for making it. Core ComfyUI nodes only.",

  "models": [
    {
      "name": "v1-5-pruned-emaonly-fp16.safetensors",
      "kind": "checkpoint",
      "license": "CreativeML Open RAIL-M",
      "node": "CheckpointLoaderSimple",
      "field": "ckpt_name"
    }
  ],
  "requires_nodes": [
    "CheckpointLoaderSimple", "CLIPTextEncode", "EmptyLatentImage",
    "KSampler", "VAEDecode", "SaveImage"
  ],

  "outputs": { "image": "artifact:image" },

  "inputs": {
    "prompt": {
      "type": "text",
      "required": true,
      "max_len": 900,
      "title": "What the picture is of"
    },
    "negative_prompt": {
      "type": "text",
      "default": "text, watermark, blurry, low quality, extra limbs",
      "max_len": 400,
      "title": "What to keep out of it"
    },
    "aspect_ratio": {
      "type": "enum",
      "choices": ["1:1", "4:3", "3:4"],
      "default": "1:1",
      "title": "Shape — SD 1.5 was trained at 512, and drifts badly past 768"
    },
    "quality": {
      "type": "enum",
      "choices": ["draft", "final"],
      "default": "draft",
      "title": "Even 'final' here is a draft; use image.product for the real one"
    },
    "seed": {
      "type": "seed",
      "title": "Recorded either way, so a promising draft can be made again"
    }
  },

  "computed": {
    "width":  { "from": "aspect_ratio", "map": { "1:1": 512, "4:3": 640, "3:4": 512 } },
    "height": { "from": "aspect_ratio", "map": { "1:1": 512, "4:3": 512, "3:4": 640 } },
    "steps":  { "from": "quality", "map": { "draft": 12, "final": 25 } },
    "cfg":    { "from": "quality", "map": { "draft": 7.0, "final": 7.5 } },
    "sampler": { "from": "quality", "map": { "draft": "euler_ancestral", "final": "dpmpp_2m" } },
    "scheduler": { "from": "quality", "map": { "draft": "normal", "final": "karras" } }
  },

  "graph": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": { "ckpt_name": "v1-5-pruned-emaonly-fp16.safetensors" }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{prompt}}", "clip": ["1", 1] }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": { "text": "{{negative_prompt}}", "clip": ["1", 1] }
    },
    "4": {
      "class_type": "EmptyLatentImage",
      "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
    },
    "5": {
      "class_type": "KSampler",
      "inputs": {
        "seed": "{{seed}}",
        "steps": "{{steps}}",
        "cfg": "{{cfg}}",
        "sampler_name": "{{sampler}}",
        "scheduler": "{{scheduler}}",
        "denoise": 1.0,
        "model": ["1", 0],
        "positive": ["2", 0],
        "negative": ["3", 0],
        "latent_image": ["4", 0]
      }
    },
    "6": {
      "class_type": "VAEDecode",
      "inputs": { "samples": ["5", 0], "vae": ["1", 2] }
    },
    "7": {
      "class_type": "SaveImage",
      "inputs": { "images": ["6", 0], "filename_prefix": "faustus/draft" }
    }
  }
}
