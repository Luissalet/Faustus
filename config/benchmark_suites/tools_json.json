{
  "id": "tools_json",
  "version": "1.0.0",
  "objective": "coding_agent",
  "cases": [
    {
      "id": "tools_json_person",
      "suite": "tools_json",
      "prompt": "Devuelve Únicamente un objeto JSON (sin texto adicional, sin bloque de código, sin explicación) con las claves \"name\" y \"age\" para una persona llamada Ana de 30 años.",
      "checks": [
        {
          "kind": "json_valid"
        },
        {
          "kind": "json_has_keys",
          "arg": [
            "name",
            "age"
          ]
        },
        {
          "kind": "no_tool_leak"
        }
      ],
      "max_tokens": 60,
      "tags": [
        "json-estricto"
      ]
    },
    {
      "id": "tools_json_coordenadas",
      "suite": "tools_json",
