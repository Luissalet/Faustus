{
  "id": "es_conversation",
  "version": "1.0.0",
  "objective": "interactive",
  "cases": [
    {
      "id": "es_conv_capital_francia",
      "suite": "es_conversation",
      "prompt": "Responde en español, en una sola frase corta: ¿cuál es la capital de Francia?",
      "checks": [
        {
          "kind": "language_es",
          "arg": null
        },
        {
          "kind": "contains",
          "arg": "París"
        },
        {
          "kind": "max_words",
          "arg": 15
        }
      ],
      "max_tokens": 60,
      "tags": [
        "geografia",
        "instruccion-simple"
      ]
    },
    {
      "id": "es_conv_lista_frutas",
      "suite": "es_conversation",
      "prompt": "En español, enumera exactamente tres frutas separadas por comas y nada más (sin frase introductoria).",
      "checks": [
        {
          "kind": "language_es"
        },
        {
          "kind": "max_words",
          "arg": 12
        }
      ],
      "max_tokens": 40,
      "tags": [
        "instruccion-formato"
      ]
    },
    {
      "id": "es_conv_negacion",
      "suite": "es_conversation",
      "prompt": "En español: si un triángulo tiene tres lados iguales se llama equilátero. ¿Cómo se llama un triángulo con dos lados iguales? Responde solo con la palabra.",
      "checks": [
        {
          "kind": "language_es"
        },
        {
          "kind": "contains",
          "arg": "isósceles"
        },
        {
          "kind": "max_words",
          "arg": 6
        }
      ],
      "max_tokens": 30,
      "tags": [
        "conocimiento-general",
        "instruccion-formato"
      ]
    },
    {
