        },
        {
          "kind": "max_words",
          "arg": 25
        }
      ],
      "max_tokens": 80,
      "tags": [
        "resumen"
      ]
    },
    {
      "id": "es_conv_conteo",
      "suite": "es_conversation",
      "prompt": "En español: ¿cuántas letras tiene la palabra \"gato\"? Responde solo con el número, en cifras.",
      "checks": [
        {
          "kind": "language_es"
